def _validate_sacenum(instance: "SacIOBase", attribute: Attribute[str], value: str) -> None:
    if not hasattr(SAC_ENUMS_DICT[attribute.name], value):
        raise ValueError(f"{value=} is an invalid enum value for sac attribute {attribute.name}.")


def _validate_with_iztype[T: int | float | None](
    instance: "SacIOBase", attribute: Attribute[T], value: T
) -> None:
    old_value = getattr(instance, attribute.name)
    if (
        instance._raw_mode is False
        and attribute.name == instance.iztype
        and old_value is not None
        and value != old_value
        and value != 0
    ):
        raise RuntimeError(
            f"Unable to change '{attribute.name}' because it is zero-time (iztype={instance.iztype})."
        )


@overload
def _null_if_undefined[T: int | float | str](
    value: T, header_name: str, optional: Literal[False]
) -> T: ...
@overload
def _null_if_undefined[T: int | float | str](
    value: T | None, header_name: str, optional: Literal[True]
) -> T | None: ...
def _null_if_undefined[T: int | float | str](
    value: T | None, header_name: str, optional: bool
) -> T | None:
    """Coerce SAC's raw 'undefined' sentinel value for this header's type to None.

    A file always writes None as this exact sentinel value and reads the
    sentinel back as None (for an optional header) - see
    SacIO.write/read_buffer. Storing the literal sentinel value here
    instead of None would silently diverge from that round-trip the moment
    the value is written and read back, so it is normalised to None at set
    time instead (both at construction and on later assignment), with a
    warning explaining why.

    A required header can never legally be None, so setting one to the
    sentinel raises immediately instead: silently nulling it would only
    postpone the failure to the field's own (unhelpfully generic)
    instance_of validator one line later.
    """
    if value is None:
        return None
    header = SAC_HEADERS.get(header_name)
    if header is None or value != HEADER_TYPES[header.type].undefined:
        return value
    if not optional:
        raise ValueError(
            f"{header_name!r} cannot be set to {value!r}, SAC's 'undefined' "
            + f"value for this header type: {header_name!r} is a required "
            + "header and can never legally be unset."
        )
    warnings.warn(
        f"{header_name!r} was set to {value!r}, SAC's 'undefined' value for "
        + "this header type. Treating it as unset (None): a file always "
        + f"writes None as {value!r} and reads {value!r} back as None, so "
        + "storing the literal value here would silently diverge from that.",
        UserWarning,
        stacklevel=2,
    )
    return None

